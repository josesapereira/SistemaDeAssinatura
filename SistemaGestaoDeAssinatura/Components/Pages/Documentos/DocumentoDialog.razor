@using Domain.DTOs
@using Domain.Enums
@using Radzen.Blazor
@attribute [Authorize]

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Tipo de Documento" class="w-100">
                <RadzenDropDown @bind-Value="@model.TipoDeDocumentoId"
                               Data="@tiposDocumento"
                               TextProperty="Nome"
                               ValueProperty="Id"
                               Placeholder="Selecione o tipo de documento"
                               Disabled="@(modoVisualizacao || temAssinatura)" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenFormField Text="Status" class="w-100">
                <RadzenBadge BadgeStyle="@BadgeStyleStatus" Text="@model.StatusDocumentoTexto" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenText Text="Assinantes" TextStyle="TextStyle.Subtitle1" />
                    @if (!modoVisualizacao && !temAssinatura)
                    {
                        <RadzenButton Size="ButtonSize.Small" Icon="add" Text="Adicionar" Click="@AdicionarAssinante" />
                    }
                </RadzenStack>
                <RadzenDataGrid TItem="AssinanteDTO" Data="@model.Assinantes" class="w-100" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="AssinanteDTO" Title="Username" Width="150px">
                            <Template>
                                @context.AssinanteId.ToString()
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AssinanteDTO" Property="UsuarioAssinante" Title="Nome do Assinante" Width="250px" />
                        <RadzenDataGridColumn TItem="AssinanteDTO" Property="StatusDaAssinatura" Title="Status" Width="150px">
                            <Template>
                                @{
                                    var badgeStyle = context.StatusDaAssinatura switch
                                    {
                                        StatusDaAssinatura.Assinado => BadgeStyle.Success,
                                        StatusDaAssinatura.Cancelado => BadgeStyle.Danger,
                                        _ => BadgeStyle.Warning
                                    };
                                    var texto = context.StatusDaAssinatura switch
                                    {
                                        StatusDaAssinatura.Assinado => "Assinado",
                                        StatusDaAssinatura.Cancelado => "Cancelado",
                                        _ => "Pendente"
                                    };
                                }
                                <RadzenBadge BadgeStyle="@badgeStyle" Text="@texto" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AssinanteDTO" Property="DataAssinatura" Title="Data Assinatura" Width="150px">
                            <Template>
                                @(context.DataAssinatura?.ToString("dd/MM/yyyy") ?? "-")
                            </Template>
                        </RadzenDataGridColumn>
                        @if (!modoVisualizacao && !temAssinatura)
                        {
                            <RadzenDataGridColumn TItem="AssinanteDTO" Title="Ações" Width="80px" Sortable="false" Filterable="false">
                                <Template>
                                    <RadzenButton Icon="delete" Size="ButtonSize.Small" 
                                                Click="@(() => RemoverAssinante(context))" 
                                                ButtonStyle="ButtonStyle.Danger" 
                                                Title="Remover" />
                                </Template>
                            </RadzenDataGridColumn>
                        }
                    </Columns>
                </RadzenDataGrid>
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenStack Gap="1rem">
                <RadzenText Text="Visualizador de PDF" TextStyle="TextStyle.Subtitle1" />
                @if (model.Arquivo != null && model.Arquivo.Length > 0)
                {
                    <iframe src="@($"data:application/pdf;base64,{Convert.ToBase64String(model.Arquivo)}")" 
                            style="width: 100%; height: 500px; border: 1px solid #ddd;" />
                }
                else
                {
                    <RadzenText Text="Nenhum documento carregado" Style="color: #999; text-align: center; padding: 2rem;" />
                }

                @if (!modoVisualizacao && !temAssinatura)
                {
                    <RadzenUpload Accept=".pdf"
                                  ChooseText="Upload PDF"
                                  InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "select file" } })"
                                  class="upload-aux"
                                  Change="UploadArquivo"
                                  Auto="true"
                                  Multiple="false"
                                  Icon="drive_folder_upload" />
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>

    <RadzenRow>
        <RadzenColumn>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" class="mt-3">
                @if (!temAssinatura)
                {
                    <RadzenButton Text="Salvar" Click="OnSubmit" Icon="save" ButtonStyle="ButtonStyle.Primary" />
                }
                @if (!temAssinatura && model.Id != Guid.Empty)
                {
                    <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@Cancelar" />
                }
                @if (temAssinatura)
                {
                    <RadzenButton Text="Revogar" Click="Revogar" Icon="block" ButtonStyle="ButtonStyle.Danger" />
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>

