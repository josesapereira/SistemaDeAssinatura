@using Domain.DTOs
@using Radzen.Blazor
@attribute [Authorize]

<RadzenStack Gap="1rem">
    <RadzenFormField Text="Selecione o Usuário" class="w-100">
        <RadzenDropDown @bind-Value="@usuarioSelecionado"
                       Data="@Usuarios"
                       TextProperty="RENome"
                       ValueProperty="Id"
                       Placeholder="Selecione um usuário"
                       AllowClear="true"
                       Filterable="true" />
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End" class="mt-3">
        <RadzenButton Text="Confirmar" Click="Confirmar" Icon="check" ButtonStyle="ButtonStyle.Primary" Disabled="@(usuarioSelecionado == null)" />
        <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Click="@Cancelar" />
    </RadzenStack>
</RadzenStack>


